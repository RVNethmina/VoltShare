<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_stations.xml - VoltShare Mobile
  List of nearby microgrid nodes, ordered by the distance the service
  calculated. The map button opens the same nodes plotted on Google Maps.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.VoltShare.Button.RailIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/nearby_nodes"
            android:textAppearance="@style/TextHeaderTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMap"
            style="@style/Widget.VoltShare.Button.Rail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_map"
            app:icon="@drawable/ic_map" />
    </LinearLayout>

    <TextView
        android:id="@+id/textNotice"
        style="@style/Widget.VoltShare.Notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_notice_warning"
        android:drawableStart="@drawable/ic_info"
        android:drawableTint="@color/status_pending_fg"
        android:textColor="@color/status_pending_fg"
        android:visibility="gone"
        tools:text="Showing saved nodes. Could not reach the service." />

    <!-- The list and its empty state share the same space, so the message
         appears where the rows would have been rather than beneath them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="10dp"
                android:paddingBottom="24dp"
                tools:listitem="@layout/item_station" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_place"
                app:tint="@color/ink_400" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/no_stations"
                android:textAppearance="@style/TextLabel" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_500"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
