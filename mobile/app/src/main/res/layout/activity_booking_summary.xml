<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_booking_summary.xml - VoltShare Mobile
  Confirmation shown after a booking is created, changed or cancelled. The
  wording comes from the Web API, so the outcome the user reads is the one the
  service actually recorded.

  This screen has no dark header, so BookingSummaryActivity asks for status bar
  icons that suit whichever theme is running.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/textIcon"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/success_bg"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/success_fg"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textAppearance="@style/TextPageTitle"
            tools:text="Booking created" />

        <TextView
            android:id="@+id/textMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextBody"
            tools:text="Booking RS-20260902-20E942 has been requested and is awaiting approval." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.VoltShare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textRef"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextSectionTitle"
                        tools:text="RS-20260902-20E942" />

                    <TextView
                        android:id="@+id/textStatus"
                        style="@style/Widget.VoltShare.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        tools:text="Pending" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_station"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textStation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textAppearance="@style/TextBody"
                        android:textColor="@color/ink_900"
                        tools:text="Colombo Fort Solar Hub" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_window"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textWindow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textAppearance="@style/TextBody"
                        android:textColor="@color/ink_900"
                        tools:text="06 Sep 2026, 19:30 - 21:30" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_energy"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textEnergy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textColor="@color/brand_600"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="25.0 kWh (Injection)" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:text="@string/done" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonViewBooking"
            style="@style/Widget.VoltShare.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/view_booking" />
    </LinearLayout>
</ScrollView>
