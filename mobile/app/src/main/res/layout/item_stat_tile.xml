<?xml version="1.0" encoding="utf-8"?>
<!--
  item_stat_tile.xml - VoltShare Mobile
  One headline figure on a dashboard. Included several times per screen so the
  tiles stay identical instead of each being laid out separately.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textTileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textColor="@color/ink_500"
            android:textSize="11sp"
            tools:text="Awaiting approval" />

        <TextView
            android:id="@+id/textTileValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_900"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="2" />

        <TextView
            android:id="@+id/textTileHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_400"
            android:textSize="11sp"
            tools:text="Bookings needing a decision" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
