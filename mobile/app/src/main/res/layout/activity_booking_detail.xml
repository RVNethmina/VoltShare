<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_booking_detail.xml - VoltShare Mobile
  One booking in full, with its transaction QR code once approved, and the
  actions the service says are still available on it.

  Whether the change and cancel buttons appear is decided entirely by the
  canBeModified and canBeCancelled flags the Web API returns, so the twelve
  hour rule is never evaluated on the device.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBack"
                style="@style/Widget.VoltShare.Button.RailIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/back"
                app:icon="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/textRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextHeaderTitle"
                tools:text="RS-20260902-20E942" />

            <TextView
                android:id="@+id/textStatus"
                style="@style/Widget.VoltShare.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                tools:text="Approved" />
        </LinearLayout>

        <TextView
            android:id="@+id/textError"
            style="@style/Widget.VoltShare.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_notice_danger"
            android:drawableStart="@drawable/ic_error"
            android:drawableTint="@color/danger_fg"
            android:textColor="@color/danger_fg"
            android:visibility="gone"
            tools:text="A booking can only be cancelled at least 12 hours before it starts." />

        <!-- Transaction QR code, shown only once the booking is approved. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQr"
            style="@style/Widget.VoltShare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transaction_qr"
                    android:textAppearance="@style/TextSectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/transaction_qr_hint"
                    android:textAppearance="@style/TextLabel" />

                <!-- A QR code is black on white, so it keeps a white plate of
                     its own even in the dark theme or a scanner cannot read
                     it off the screen. -->
                <ImageView
                    android:id="@+id/imageQr"
                    android:layout_width="248dp"
                    android:layout_height="248dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_qr_frame"
                    android:contentDescription="@string/transaction_qr"
                    android:padding="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Booking details -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.VoltShare.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_details"
                    android:textAppearance="@style/TextEyebrow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_station"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textStation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textAppearance="@style/TextBody"
                        android:textColor="@color/ink_900"
                        tools:text="Colombo Fort Solar Hub" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_window"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textWindow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textAppearance="@style/TextBody"
                        android:textColor="@color/ink_900"
                        tools:text="06 Sep 2026, 19:30 - 21:30" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_transfer"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textAppearance="@style/TextBody"
                        android:textColor="@color/ink_900"
                        tools:text="Injection" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_energy"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textEnergy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textColor="@color/brand_600"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="25.0 kWh" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_requested"
                        android:textAppearance="@style/TextLabel" />

                    <TextView
                        android:id="@+id/textCreated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:textAppearance="@style/TextLabel"
                        tools:text="02 Sep 2026, 20:00" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Availability of these actions is decided by the service. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonModify"
            style="@style/Widget.VoltShare.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/modify_booking"
            android:visibility="gone"
            app:icon="@drawable/ic_edit"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancel"
            style="@style/Widget.VoltShare.Button.Outlined.Danger"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:text="@string/cancel_booking"
            android:visibility="gone"
            app:icon="@drawable/ic_close"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textLocked"
            style="@style/Widget.VoltShare.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_notice_neutral"
            android:drawableStart="@drawable/ic_info"
            android:drawableTint="@color/ink_500"
            android:textColor="@color/ink_500"
            android:visibility="gone"
            tools:text="This booking can no longer be changed." />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/brand_500"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
