<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_booking_detail.xml - VoltShare Mobile
  One booking in full, with its transaction QR code once approved, and the
  actions the service says are still available on it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_100"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ink_900"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="RS-20260902-20E942" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                tools:text="Approved" />
        </LinearLayout>

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/status_rejected_bg"
            android:padding="12dp"
            android:textColor="@color/status_rejected_fg"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="A booking can only be cancelled at least 12 hours before it starts." />

        <!-- Transaction QR code, shown only once the booking is approved. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transaction_qr"
                    android:textAppearance="@style/TextSectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/transaction_qr_hint"
                    android:textAppearance="@style/TextLabel" />

                <ImageView
                    android:id="@+id/imageQr"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/transaction_qr" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Booking details -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_details"
                    android:textAppearance="@style/TextSectionTitle" />

                <TextView
                    android:id="@+id/textStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextBody"
                    tools:text="Station: Colombo Fort Solar Hub" />

                <TextView
                    android:id="@+id/textWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextBody"
                    tools:text="Window: 06 Sep 2026, 19:30 - 21:30" />

                <TextView
                    android:id="@+id/textType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextBody"
                    tools:text="Transfer: Injection" />

                <TextView
                    android:id="@+id/textEnergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextBody"
                    tools:text="Energy: 25.0 kWh" />

                <TextView
                    android:id="@+id/textCreated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextLabel"
                    tools:text="Requested 02 Sep 2026, 20:00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Availability of these actions is decided by the service. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonModify"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/modify_booking"
            android:visibility="gone"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/danger"
            android:text="@string/cancel_booking"
            android:visibility="gone"
            app:cornerRadius="10dp" />

        <TextView
            android:id="@+id/textLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/ink_200"
            android:padding="12dp"
            android:textAppearance="@style/TextLabel"
            android:visibility="gone"
            tools:text="This booking can no longer be changed." />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
