<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_create_booking.xml - VoltShare Mobile
  Requests a new energy transfer booking, or moves an existing one to another
  window. The seven day and twelve hour rules are enforced by the Web API; this
  screen only collects the choice and reports what the service decides.

  The windows offered are the ones the service returned for the chosen node,
  and each one already carries the remaining capacity it calculated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.VoltShare.Button.RailIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_energy"
                android:textAppearance="@style/TextHeaderTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/book_energy_hint"
                android:textAppearance="@style/TextHeaderSubtitle" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textError"
        style="@style/Widget.VoltShare.Notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_notice_danger"
        android:drawableStart="@drawable/ic_error"
        android:drawableTint="@color/danger_fg"
        android:textColor="@color/danger_fg"
        android:visibility="gone"
        tools:text="Bookings can only be made up to 7 days in advance." />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Station -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginTop="18dp"
                android:text="@string/choose_node"
                android:textAppearance="@style/TextEyebrow" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutStation"
                style="@style/Widget.VoltShare.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:hint="@string/station">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/inputStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Transfer direction -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginTop="20dp"
                android:text="@string/transfer_direction"
                android:textAppearance="@style/TextEyebrow" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonInjection"
                    style="@style/Widget.VoltShare.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_injection" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonWithdrawal"
                    style="@style/Widget.VoltShare.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_withdrawal" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Windows -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="@string/choose_window"
                android:textAppearance="@style/TextEyebrow" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_slot" />

            <LinearLayout
                android:id="@+id/textNoSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_notice_neutral"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/ink_400" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/no_slots"
                    android:textAppearance="@style/TextLabel" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:indeterminateTint="@color/brand_500"
        android:visibility="gone" />

    <!-- The confirm button is pinned above the navigation bar; the bottom
         inset is added to it by SystemBars.applyInsets. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:minHeight="54dp"
        android:text="@string/confirm_booking" />
</LinearLayout>
