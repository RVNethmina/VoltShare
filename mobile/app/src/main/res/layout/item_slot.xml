<?xml version="1.0" encoding="utf-8"?>
<!--
  item_slot.xml - VoltShare Mobile
  One bookable window in the slot picker. The remaining capacity is the value
  the service calculated, so the device never works out whether a window is
  still available.

  The card is checkable: SlotAdapter raises the stroke on the selected window,
  which is what shows the user which one their booking will use.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSlot"
    style="@style/Widget.VoltShare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:rippleColor="@color/brand_soft"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/surface_2"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_clock"
            app:tint="@color/ink_500" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextSectionTitle"
                tools:text="06 Sep 2026, 09:00 - 11:00" />

            <TextView
                android:id="@+id/textEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextLabel"
                tools:text="12.0 kWh per place" />
        </LinearLayout>

        <TextView
            android:id="@+id/textRemaining"
            style="@style/Widget.VoltShare.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            tools:text="3 free" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
