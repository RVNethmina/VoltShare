<?xml version="1.0" encoding="utf-8"?>
<!--
  themes.xml - VoltShare Mobile
  The application theme and the reusable widget styles.

  Everything here is defined once and inherited by every screen: a layout asks
  for "@style/Widget.VoltShare.Button" rather than repeating a corner radius, a
  height and a colour on each button. Because every value resolves to a name in
  colors.xml, and values-night redefines those names, this single file styles
  both the light and the dark theme.

  There is no values-night copy of this file. Only the palette changes between
  the two themes, and the palette lives in colors.xml.
-->
<resources>

    <!-- ===================================================================
         Application theme
         =================================================================== -->

    <style name="Base.Theme.Voltshare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/brand_fg</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_soft_fg</item>

        <!-- Neutrals. Material draws cards, sheets and menus from these. -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink_900</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/ink_500</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorOutline">@color/line</item>

        <!-- Material washes a raised surface with the primary colour, more
             strongly the higher it sits. On an amber brand that turns a raised
             card cream rather than leaving it the surface colour, which is
             wrong beside the flat cards used everywhere else. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorOnBackground">@color/ink_900</item>

        <!-- Feedback -->
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/danger_bg</item>
        <item name="colorOnErrorContainer">@color/danger_fg</item>

        <!-- Window. The bars are transparent because every screen draws its
             own dark header behind the status bar; SystemBars.applyInsets
             keeps the content clear of it. -->
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Defaults, so a plain widget in a layout is already styled. -->
        <item name="materialButtonStyle">@style/Widget.VoltShare.Button</item>
        <item name="materialCardViewStyle">@style/Widget.VoltShare.Card</item>
        <item name="textInputStyle">@style/Widget.VoltShare.TextInput</item>
        <item name="chipStyle">@style/Widget.VoltShare.Chip</item>
        <item name="android:textColorHint">@color/ink_500</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VoltShare.Dialog</item>
    </style>

    <style name="Theme.Voltshare" parent="Base.Theme.Voltshare" />

    <!-- Confirmation dialogs. Without this they are drawn from Material's own
         defaults and look like they belong to a different application. -->
    <style name="ThemeOverlay.VoltShare.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Material tints a raised surface lighter the higher it sits. That
             turns the dialog grey rather than the navy the rest of the dark
             theme uses, so the overlay is switched off. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorOnSurface">@color/ink_900</item>
        <item name="colorOnSurfaceVariant">@color/ink_700</item>
        <item name="colorPrimary">@color/brand_600</item>
        <item name="android:textColorHint">@color/ink_500</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.VoltShare.DialogTitle</item>
    </style>

    <style name="TextAppearance.VoltShare.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
    </style>

    <!-- ===================================================================
         Text
         Applied with android:textAppearance. The neutral ramp inverts in the
         dark theme, so ink_900 is always the strongest text colour.
         =================================================================== -->

    <style name="TextPageTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextSectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
    </style>

    <!-- Small uppercase caption above a group of content. -->
    <style name="TextEyebrow">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_500</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <style name="TextLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_500</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_700</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- A headline figure on a dashboard tile. -->
    <style name="TextMetric">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Text on the dark header bar, which stays dark in both themes. -->
    <style name="TextHeaderTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextHeaderSubtitle">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/rail_muted</item>
    </style>

    <!-- ===================================================================
         Widgets
         =================================================================== -->

    <!-- Outlined rather than raised. A drop shadow is close to invisible on a
         dark background, so a hairline border separates cards in both themes. -->
    <style name="Widget.VoltShare.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.VoltShare.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconPadding">8dp</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_fg</item>
        <item name="iconTint">@color/btn_primary_fg</item>
    </style>

    <style name="Widget.VoltShare.Button.Danger">
        <item name="backgroundTint">@color/btn_danger_bg</item>
        <item name="android:textColor">@color/btn_on_fill</item>
        <item name="iconTint">@color/btn_on_fill</item>
    </style>

    <style name="Widget.VoltShare.Button.Success">
        <item name="backgroundTint">@color/btn_success_bg</item>
        <item name="android:textColor">@color/btn_on_fill</item>
        <item name="iconTint">@color/btn_on_fill</item>
    </style>

    <style name="Widget.VoltShare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconPadding">8dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/btn_outlined_fg</item>
        <item name="iconTint">@color/btn_outlined_fg</item>
        <item name="strokeColor">@color/btn_outlined_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- A destructive action that should not shout: outlined, but in red. -->
    <style name="Widget.VoltShare.Button.Outlined.Danger">
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
    </style>

    <!-- Sits on the dark header bar, so it uses fixed light colours. -->
    <style name="Widget.VoltShare.Button.Rail" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="android:textColor">@color/btn_rail_fg</item>
        <item name="iconTint">@color/btn_rail_fg</item>
        <item name="strokeColor">@color/btn_rail_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Round icon-only button for the back arrow in a header. -->
    <style name="Widget.VoltShare.Button.RailIcon" parent="Widget.Material3.Button.IconButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- One segment of the transfer direction switch. -->
    <style name="Widget.VoltShare.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/btn_toggle_bg</item>
        <item name="android:textColor">@color/btn_toggle_fg</item>
        <item name="iconTint">@color/btn_toggle_fg</item>
        <item name="strokeColor">@color/btn_toggle_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.VoltShare.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brand_600</item>
        <item name="iconTint">@color/brand_600</item>
        <item name="rippleColor">@color/brand_soft</item>
    </style>

    <style name="Widget.VoltShare.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/brand_600</item>
        <item name="android:textColorHint">@color/ink_500</item>
        <item name="helperTextTextColor">@color/ink_500</item>
    </style>

    <!-- The dropdown variant has to inherit from the exposed menu style or the
         drop down arrow and the menu behaviour are lost. -->
    <style name="Widget.VoltShare.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/brand_600</item>
        <item name="android:textColorHint">@color/ink_500</item>
    </style>

    <style name="Widget.VoltShare.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_fg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Status pill. StatusStyles tints the background at runtime, which is
         why the drawable underneath is plain white. -->
    <style name="Widget.VoltShare.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Message panel returned by the service: refused, cautionary or
         confirming. The background and icon are set by the layout. -->
    <style name="Widget.VoltShare.Notice" parent="">
        <item name="android:padding">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
