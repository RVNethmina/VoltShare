<?xml version="1.0" encoding="utf-8"?>
<!--
  chip_bg.xml - VoltShare Mobile
  Fill of a status filter chip. The selected chip takes the brand colour so the
  active filter is obvious at a glance.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_500" android:state_checked="true" />
    <item android:color="@color/surface" />
</selector>
