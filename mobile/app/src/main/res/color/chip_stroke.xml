<?xml version="1.0" encoding="utf-8"?>
<!--
  chip_stroke.xml - VoltShare Mobile
  Border of a status filter chip. The selected chip has no visible border,
  because its fill already carries the selection.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@android:color/transparent" android:state_checked="true" />
    <item android:color="@color/line" />
</selector>
