<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_qr_frame.xml - VoltShare Mobile
  A QR code is generated as black modules on white, so it must keep a white
  plate underneath it even in the dark theme or the scanner cannot read it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white" />
    <corners android:radius="14dp" />
</shape>
