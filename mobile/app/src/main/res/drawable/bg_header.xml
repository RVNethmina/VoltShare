<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_header.xml - VoltShare Mobile
  The dark bar at the top of every screen. The bottom corners are rounded so
  the header reads as a panel resting on the page rather than a flat band, and
  the gradient keeps it from looking like a solid block of colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/rail_2"
        android:startColor="@color/rail" />
    <corners
        android:bottomLeftRadius="26dp"
        android:bottomRightRadius="26dp" />
</shape>
