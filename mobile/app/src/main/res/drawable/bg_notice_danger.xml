<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_notice_danger.xml - VoltShare Mobile
  Panel behind a message the service refused. Both colours come from the
  palette, so the panel restyles itself in the dark theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/danger_bg" />
    <stroke android:width="1dp" android:color="@color/danger_fg" />
    <corners android:radius="12dp" />
</shape>
