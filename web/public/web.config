<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config - VoltShare Web (React single page application)

  Placed in public/ so that Vite copies it into dist/ on every build and it is
  deployed alongside the compiled site.

  The application uses client side routing, so a browser asking IIS directly for
  a path such as /reservations is asking for a file that does not exist on disk.
  The httpErrors rule below hands index.html back for those requests and lets
  React Router work out which screen to show.

  This approach is used because it needs no extra IIS modules. Installing the
  IIS URL Rewrite module would allow the same fallback to return a proper 200
  instead of a 404 status; the page renders correctly either way.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Declared explicitly so IIS serves the build assets with the right
           content type rather than refusing an extension it does not know. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
