<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config - VoltShare.Api

  Tells IIS how to host the ASP.NET Core application. The publish step fills in
  the processPath and arguments automatically; the settings kept here are the
  ones this project chooses deliberately.

  hostingModel="inprocess" runs the application inside the IIS worker process,
  which is faster than the out of process model because requests do not have to
  be forwarded to a separate Kestrel server over a local socket.

  stdoutLogEnabled is switched on so that a start-up failure writes a readable
  reason into the logs folder. Without it IIS reports only a generic HTTP 500.19
  or 502.5 and there is nothing to diagnose from.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\VoltShare.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!--
            Selects appsettings.Production.json. That file holds the MongoDB
            connection string and signing keys, because user secrets are only
            loaded in the Development environment and would be ignored here.
          -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
